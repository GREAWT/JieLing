{
  "name": "qoder-site-react-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "preinstall": "node scripts/check-node.mjs",
    "predev": "node scripts/check-node.mjs",
    "prebuild": "node scripts/check-node.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "node src/knowledge/build-rules.mjs && tsc --noEmit && node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 127.0.0.1",
    "dev:function": "deno run --allow-net --allow-env dev/function-local.ts",
    "check:function": "deno check functions/index.ts",
    "build:rules": "node src/knowledge/build-rules.mjs",
    "test:function": "node dev/function-test.mjs",
    "test:diagnose": "node dev/diagnose-test.mjs",
    "test:app": "node dev/app-test.mjs",
    "test:fs": "node dev/fs-test.mjs",
    "test:ps": "node dev/ps-script-test.mjs",
    "test:ps:live": "node dev/ps-live-test.mjs",
    "test:e2e": "node dev/browser-e2e.mjs",
    "verify": "npm run typecheck && npm run test:function && npm run test:diagnose && npm run test:app && npm run test:fs && npm run test:ps && npm run test:ps:live && npm run test:e2e && npm run build"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@shadcn/react": "^0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.31.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vite": "8.0.16"
  },
  "type": "module"
}
